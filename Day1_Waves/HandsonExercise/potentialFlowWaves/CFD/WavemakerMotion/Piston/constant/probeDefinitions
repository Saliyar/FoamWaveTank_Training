FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      probeDefinitions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wave gauges for waveGaugesNProbes: CFD x = 3 .. 7 m (= HOS probes x = 7 .. 11 m
// in prob.inp of the HOS case), vertical from z = -0.49 to z = 0.29

surfaceElevation
{
    type waveGauge;

    pointDistribution userDefinedDistribution;
    N 5;
    xValues nonuniform 5(3 4 5 6 7);
    yValues uniform 0;
    zValues uniform -0.49;

    add       (0 0 0.78);
    axis      z;

    writeControl  adjustableRunTime;
    writeInterval 0.02;
}

