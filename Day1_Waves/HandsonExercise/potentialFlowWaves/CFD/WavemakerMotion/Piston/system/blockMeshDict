FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 2D numerical wave flume, Day 1
//   x: 0 .. 18 m   inlet relaxation zone 0..3, outlet zone 12..18
//   z: -0.5 .. 0.3 m, still water level z = 0, depth 0.5 m
//   dx = 0.025 m, dz = 0.01 m in the free-surface band -0.15 .. 0.15

scale 1;

x0   0;   x1  10;     // CFD x = HOS x - 4  (HOS x = 4 .. 14 m)
y0  -0.01; y1  0.01;
z0  -0.5; z1  -0.15; z2  0.15; z3  0.3;

nx   400;
nz0   10;   // bottom layer  (dz = 0.035)
nz1   30;   // surface band  (dz = 0.01)
nz2    6;   // air           (dz = 0.025)

vertices
(
    ($x0 $y0 $z0) ($x1 $y0 $z0) ($x1 $y1 $z0) ($x0 $y1 $z0)
    ($x0 $y0 $z1) ($x1 $y0 $z1) ($x1 $y1 $z1) ($x0 $y1 $z1)
    ($x0 $y0 $z2) ($x1 $y0 $z2) ($x1 $y1 $z2) ($x0 $y1 $z2)
    ($x0 $y0 $z3) ($x1 $y0 $z3) ($x1 $y1 $z3) ($x0 $y1 $z3)
);

blocks
(
    hex ( 0  1  2  3  4  5  6  7) ($nx 1 $nz0) simpleGrading (1 1 1)
    hex ( 4  5  6  7  8  9 10 11) ($nx 1 $nz1) simpleGrading (1 1 1)
    hex ( 8  9 10 11 12 13 14 15) ($nx 1 $nz2) simpleGrading (1 1 1)
);

boundary
(
    inlet
    {
        type patch;
        faces ((0 4 7 3) (4 8 11 7) (8 12 15 11));
    }
    outlet
    {
        type patch;
        faces ((1 2 6 5) (5 6 10 9) (9 10 14 13));
    }
    bottom
    {
        type wall;
        faces ((0 3 2 1));
    }
    atmosphere
    {
        type patch;
        faces ((12 13 14 15));
    }
    frontBack
    {
        type empty;
        faces
        (
            (0 1 5 4) (4 5 9 8) (8 9 13 12)
            (3 7 6 2) (7 11 10 6) (11 15 14 10)
        );
    }
);

