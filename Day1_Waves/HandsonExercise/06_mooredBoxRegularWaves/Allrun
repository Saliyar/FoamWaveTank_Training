#!/bin/sh
#------------------------------------------------------------------------------
# Day 1 - 06  The Day 3 / Day 4 regular wave in the empty tank (no box)
#   Same tank, mesh and wave as Day3_MooredBox/mooredBox_waveIsoFoam and the
#   Day 4 SWENSE cases: depth 0.5 m, x = -2.5 .. 2.5 m, box position x = 0
#   (the hole for the box in the Day 3 mesh is filled with one block).
#   Wave:   OpenFOAM waveModels, StokesII, H = 0.1195 m, T = 1.993 s,
#           generated and absorbed at the inlet patch (constant/waveProperties)
#   Solver: interIsoFoam (Day 3: waveIsoFoam without relaxation zones)
#
# Usage:  ./Allrun
#   Wave gauges -> postProcessing/waveGauges (x = -2 .. 2 m, incl. x = 0)
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

touch case.foam
restore0Dir

# 1. Mesh
runApplication blockMesh
runApplication checkMesh

# 2. Initial free surface (still water, z < 0)
runApplication setFields

# 3. Run (serial)
runApplication $(getApplication)

#------------------------------------------------------------------------------
