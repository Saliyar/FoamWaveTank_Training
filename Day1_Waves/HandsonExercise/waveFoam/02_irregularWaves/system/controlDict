FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Day 1 - irregular waves (JONSWAP, random phase)

application     waveFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         40;

deltaT          0.001;
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.05;

writeControl    adjustableRunTime;
writeInterval   0.5;
purgeWrite      0;
writeFormat     binary;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

libs ( "libwaves2Foam.so" );

functions
{
    // Wave gauges written by the utility waveGaugesNProbes (see Allrun)
    #includeIfPresent "../waveGaugesNProbes/surfaceElevation_controlDict";
}

