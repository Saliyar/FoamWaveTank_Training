FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      probeDefinitions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wave gauges for waveGaugesNProbes: 6 vertical gauges from the bottom
// (z = -0.49) to the top (z = 0.29); x = 2 (in the inlet zone), 4, 6, 8, 10, 12

surfaceElevation
{
    type waveGauge;

    pointDistribution userDefinedDistribution;
    N 6;
    xValues nonuniform 6(2 4 6 8 10 12);
    yValues uniform 0;
    zValues uniform -0.49;

    add       (0 0 0.78);
    axis      z;

    writeControl  adjustableRunTime;
    writeInterval 0.02;
}

