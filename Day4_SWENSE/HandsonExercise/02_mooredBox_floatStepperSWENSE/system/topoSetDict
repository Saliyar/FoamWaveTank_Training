FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// plainBodyZone from the morphing outer box (spec item 6): cells with a point
// strictly inside the outer box (points on its faces have scale 0 and do not
// move; 1e-4 m inside), cut at cell centre z < zCut = 0.1118.

actions
(
    {
        name    outerBoxPoints;
        type    pointSet;
        action  new;
        source  boxToPoint;
        box     (-0.6999 -1 -0.3499) (0.6999 1 0.1117);
    }
    {
        name    bodyZoneCells;
        type    cellSet;
        action  new;
        source  pointToCell;
        sets    (outerBoxPoints);
        option  any;
    }
    {
        name    bodyZoneCells;
        type    cellSet;
        action  subset;
        source  boxToCell;
        box     (-1000 -1000 -1000) (1000 1000 0.1118);
    }
    {
        name    bodyZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     bodyZoneCells;
    }
);

