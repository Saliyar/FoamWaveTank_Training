#!/bin/sh
#------------------------------------------------------------------------------
# Day 4a - Moored box in regular waves, waveIsoFoamSWENSE (Rev1, moving body)
#   Same box, mooring and wave as Day 3; SWENSE splits the solution into the
#   incident wave (StokesIIIncident) and the complementary field (Uc, pc).
#   bodyZone = cells around the box where the complementary flow is solved
#   (cut 5 cell rows below the atmosphere, z < 0.1118).
#   Adaptive dt (maxCo 0.5), level correction OFF (set-up of run E/S3).
#
# Solver: waveIsoFoamSWENSE from ./Allwmake of FoamWaveTank (master).
#         Another build: SOLVER=/path/to/waveIsoFoamSWENSE ./Allrun
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

SOLVER=${SOLVER:-waveIsoFoamSWENSE}

touch case.foam
restore0Dir

# 1. Mesh (identical to Day 3) + the SWENSE body zone
# Mesh size: MESH=coarse | medium (default) | fine, e.g.  MESH=coarse ./Allrun
MESH=${MESH:-medium}
[ -f system/meshSize.$MESH ] || { echo "MESH must be coarse, medium or fine"; exit 1; }
cp system/meshSize.$MESH system/meshSize

runApplication blockMesh
if [ "$MESH" = medium ]; then
    cp constant/cellZones.bodyZone constant/polyMesh/cellZones
else
    runApplication topoSet -dict system/topoSetDict.bodyZone   # the same region: |x| < 0.5 m, z < 0.1118 m
fi
runApplication checkMesh

# 2. Initial fields: the SWENSE solver builds alpha/U/p from the incident
#    wave (alphaI, UInc, pInc) itself; 0.orig holds the complementary fields
#    Uc = 0, pc = 0, so no setFields is needed here.

# 3. Run (serial). Wave gauges, forces (p, pInc, pc) and 6-DoF state are
#    written by the function objects in system/controlDict -> postProcessing/
runApplication $SOLVER

#------------------------------------------------------------------------------
