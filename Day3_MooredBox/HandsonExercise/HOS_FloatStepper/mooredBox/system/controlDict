// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     floatStepperWaveFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         23;

deltaT          0.00125;

writeControl    adjustableRunTime;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  16;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.5;

maxDeltaT       0.005;      // the box is almost at rest before the waves arrive

libs            ( "libwaves2Foam.so" "libfloaterMotion.so" moorDynForFloatStepper );

functions
{
    floaterMotion
    {
        type            floaterStateWriter;
        libs            ( floaterStateWriter );
        writeControl    timeStep;
        writeInterval   1;
        classicWriteFormat false;
        bodyName        box;
    }
    surfaceElevation
    {
        type            surfaceElevation;
        libs            ( "libwaves2Foam.so" "libwaves2FoamSampling.so" );
        writeControl    runTime;
        writeInterval   0.02;
        setFormat       raw;
        interpolationScheme cellPointFace;
        fields          (alpha.water);
        sets
        (
            gauge_0
            {
                type    face;
                axis    z;
                start   (-2 0 -0.499);
                end     (-2 0 0.499);
                nPoints 100;
            }
            gauge_1
            {
                type    face;
                axis    z;
                start   (-1.5 0 -0.499);
                end     (-1.5 0 0.499);
                nPoints 100;
            }
            gauge_2
            {
                type    face;
                axis    z;
                start   (-1 0 -0.499);
                end     (-1 0 0.499);
                nPoints 100;
            }
            gauge_3
            {
                type    face;
                axis    z;
                start   (-0.5 0 -0.499);
                end     (-0.5 0 0.499);
                nPoints 100;
            }
            gauge_4
            {
                type    face;
                axis    z;
                start   (-0.25 0 -0.499);
                end     (-0.25 0 0.499);
                nPoints 100;
            }
            gauge_5
            {
                type    face;
                axis    z;
                start   (0.25 0 -0.499);
                end     (0.25 0 0.499);
                nPoints 100;
            }
            gauge_6
            {
                type    face;
                axis    z;
                start   (0.5 0 -0.499);
                end     (0.5 0 0.499);
                nPoints 100;
            }
            gauge_7
            {
                type    face;
                axis    z;
                start   (1 0 -0.499);
                end     (1 0 0.499);
                nPoints 100;
            }
            gauge_8
            {
                type    face;
                axis    z;
                start   (1.5 0 -0.499);
                end     (1.5 0 0.499);
                nPoints 100;
            }
            gauge_9
            {
                type    face;
                axis    z;
                start   (2 0 -0.499);
                end     (2 0 0.499);
                nPoints 100;
            }
        );
    }
}


