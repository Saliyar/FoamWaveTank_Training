FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "0/uniform";
    object      floaters;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Moored box at its Phase E (E/S3) equilibrium position: same mass, centre of
// mass and inertia as the sixDoF set-up of Day 3 / Day 4a.

box
{
    centreOfRotation ( 0 0 -0.0126 );
    orientation     ( 1 0 0 0 1 0 0 0 1 );
    velocity        ( 0 0 0 );
    acceleration    ( 0 0 0 );
    angularVelocity ( 0 0 0 );
    angularAcceleration ( 0 0 0 );
    mass            3.148;
    centreOfMass    $centreOfRotation;
    momentOfInertia ( 0.015 0 0 0.0167 0 0.021 );

    initialCentreOfRotation $centreOfRotation;
    initialOrientation $orientation;
    initialCentreOfMass $initialCentreOfRotation;
}

