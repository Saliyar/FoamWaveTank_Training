#!/bin/sh
#------------------------------------------------------------------------------
# Day 3 - Moored box in regular waves, plain waveIsoFoam
#   sixDoFRigidBodyMotion (Newmark) + MoorDyn v2 (4 lines, BODY coupling)
#   StokesII incident wave, H = 0.1195 m, relaxation zones from waves2Foam
#
# Usage:  ./Allrun                     (serial, local machine)
#
# Solver: the build used for run E/P2 (fwt_rev1_floating/private). The
# waveIsoFoam in FOAM_USER_APPBIN currently registers isoAdvector twice
# ("Duplicate entry isoAlpha") and crashes at exit. Override with
#         FWT_PLAIN=/path/to/build ./Allrun   (expects bin/ and lib/)
#         SOLVER=/path/to/waveIsoFoam ./Allrun
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions

FWT_PLAIN=${FWT_PLAIN:-/gpfs/hpc-home/projects/dtu_00075/apps/FoamWaveTank/fwt_rev1_floating/private}
SOLVER=${SOLVER:-$FWT_PLAIN/bin/waveIsoFoam}
[ -d "$FWT_PLAIN/lib" ] && export LD_LIBRARY_PATH="$FWT_PLAIN/lib:$LD_LIBRARY_PATH"

touch case.foam
restore0Dir

# 1. Mesh
# Mesh size: MESH=coarse | medium (default) | fine, e.g.  MESH=coarse ./Allrun
MESH=${MESH:-medium}
[ -f system/meshSize.$MESH ] || { echo "MESH must be coarse, medium or fine"; exit 1; }
cp system/meshSize.$MESH system/meshSize

runApplication blockMesh
runApplication checkMesh

# 2. Initial free surface (still water, z < 0)
runApplication setFields

# 3. Run (serial). Wave gauges, box forces and 6-DoF state are written by
#    the function objects in system/controlDict -> postProcessing/
runApplication $SOLVER

#------------------------------------------------------------------------------
