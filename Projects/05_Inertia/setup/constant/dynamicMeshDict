FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      dynamicMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dynamicFvMesh       dynamicMotionSolverFvMesh;

motionSolverLibs    (sixDoFRigidBodyMotion);

motionSolver        sixDoFRigidBodyMotion;

sixDoFRigidBodyMotionCoeffs
{
    patches         (box);
    innerDistance   0.075;
    outerDistance   0.4;

    rho             rho;

    mass            3.148;
    centreOfMass    (0 0 -0.0126);
    momentOfInertia (0.015 0.0167 0.021);   // (Ixx Iyy Izz): pitch uses Iyy only

    accelerationRelaxation 0.4;

    report          on;

    solver
    {
        type        Newmark;
    }

    constraints
    {
        xzPlane
        {
            sixDoFRigidBodyMotionConstraint plane;
            normal      (0 1 0);
        }
        yAxis
        {
            sixDoFRigidBodyMotionConstraint axis;
            axis        (0 1 0);
        }
    }

    restraints
    {
        moorDynR2_body
        {
            sixDoFRigidBodyMotionRestraint  moorDynR2;
            couplingMode        "BODY";
            inputFile           "Mooring/lines_v2_bodyC.txt";
            vtkPrefix           "mdv2_body";
            writeMooringVTK     true;
            vtkStartTime        0;
            outerCorrector      1;
        }
    }
}

