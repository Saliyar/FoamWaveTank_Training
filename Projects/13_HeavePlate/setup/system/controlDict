// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    location        "system";
    object          controlDict;
}

application     waveIsoFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         23;

deltaT          0.00125;

writeControl    adjustableRunTime;

writeInterval   0.5;        // fields for ParaView

purgeWrite      0;

writeFormat     ascii;

writePrecision  10;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable yes;

// Adaptive time step
adjustTimeStep  yes;

maxCo           0.5;

maxAlphaCo      0.5;

maxDeltaT       1;

libs            ( "libwaves2Foam.so" "libGrid2Grid.so" waveModels moorDynR2SixDoF );

functions
{
    box_forces
    {
        type            forces;
        libs            ( forces );
        patches         ( box );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    sixDoFState
    {
        type            sixDoFRigidBodyState;
        libs            ( sixDoFRigidBodyState );
        angleFormat     degrees;
        writeControl    timeStep;
        writeInterval   1;
    }
    waveGauges
    {
        type            interfaceHeight;
        libs            ( fieldFunctionObjects );
        alpha           alpha.water;
        direction       (0 0 -1);   // gravity direction (interfaceHeight)
        locations       ( ( -2 0 -0.45 ) ( -1.5 0 -0.45 ) ( -1 0 -0.45 ) ( -0.5 0 -0.45 ) ( -0.25 0 -0.45 ) ( 0.25 0 -0.45 ) ( 0.5 0 -0.45 ) ( 1 0 -0.45 ) ( 1.5 0 -0.45 ) ( 2 0 -0.45 ) );
        writeControl    timeStep;
        writeInterval   1;
    }
}


