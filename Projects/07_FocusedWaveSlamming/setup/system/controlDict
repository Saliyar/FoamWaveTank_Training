FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     waveIsoFoamSWENSE;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         14;
deltaT          0.0008;
writeControl    adjustableRunTime;
writeInterval   0.5;        // fields for ParaView
purgeWrite      0;
writeFormat     ascii;
writePrecision  10;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable no;
// Adaptive time step
adjustTimeStep  yes;
maxCo           0.5;
maxAlphaCo      0.5;
maxDeltaT       0.002;      // resolves the impact
libs            ( "libwaves2Foam.so" "libGrid2Grid.so" moorDynR2SixDoF );
functions
{
    waveGauges
    {
        type            interfaceHeight;
        libs            ( fieldFunctionObjects );
        alpha           alpha.water;
        direction       (0 0 -1);   // gravity direction (interfaceHeight)
        locations       ( ( -2 0 -0.45 ) ( -1.5 0 -0.45 ) ( -1 0 -0.45 ) ( -0.5 0 -0.45 ) ( -0.25 0 -0.45 ) ( 0.25 0 -0.45 ) ( 0.5 0 -0.45 ) ( 1 0 -0.45 ) ( 1.5 0 -0.45 ) ( 2 0 -0.45 ) );
        writeControl    timeStep;
        writeInterval   1;
    }
    sixDoFState
    {
        type            sixDoFRigidBodyState;
        libs            ( sixDoFRigidBodyState );
        angleFormat     degrees;
        writeControl    timeStep;
        writeInterval   1;
    }
    box_forces
    {
        type            forces;
        libs            ( forces );
        patches         ( "box.*" );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    box_forces_pInc
    {
        type            forces;
        libs            ( forces );
        patches         ( "box.*" );
        pName           pInc;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    box_forces_pc
    {
        type            forces;
        libs            ( forces );
        patches         ( "box.*" );
        pName           pc;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    force_boxBottom
    {
        type            forces;
        libs            ( forces );
        patches         ( boxBottom );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    max_boxBottom
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxBottom;
        operation       max;
        fields          ( p );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    areaAverage_boxBottom
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxBottom;
        operation       areaAverage;
        fields          ( p alpha.water );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    force_boxDeck
    {
        type            forces;
        libs            ( forces );
        patches         ( boxDeck );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    max_boxDeck
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxDeck;
        operation       max;
        fields          ( p );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    areaAverage_boxDeck
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxDeck;
        operation       areaAverage;
        fields          ( p alpha.water );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    force_boxFront
    {
        type            forces;
        libs            ( forces );
        patches         ( boxFront );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    max_boxFront
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxFront;
        operation       max;
        fields          ( p );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    areaAverage_boxFront
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxFront;
        operation       areaAverage;
        fields          ( p alpha.water );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    force_boxBack
    {
        type            forces;
        libs            ( forces );
        patches         ( boxBack );
        pName           p;
        rho             rho;
        CofR            ( 0 0 0 );
        writeControl    timeStep;
        writeInterval   1;
    }
    max_boxBack
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxBack;
        operation       max;
        fields          ( p );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
    areaAverage_boxBack
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        regionType      patch;
        name            boxBack;
        operation       areaAverage;
        fields          ( p alpha.water );
        writeFields     false;
        log             false;
        writeControl    timeStep;
        writeInterval   1;
    }
}
