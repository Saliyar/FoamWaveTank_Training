FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases (water air);

water
{
    transportModel  Newtonian;
    nu              1e-06;
    rho             rho [ 1 -3 0 0 0 0 0 ] 1000;   // waves2Foam needs the dimensions
}

air
{
    transportModel  Newtonian;
    nu              1.48e-05;
    rho             rho [ 1 -3 0 0 0 0 0 ] 1;   // waves2Foam needs the dimensions
}


// no surface tension, as in FloatStepper/mooredBox
sigma               0;


