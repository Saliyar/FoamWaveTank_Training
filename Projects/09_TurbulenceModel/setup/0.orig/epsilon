FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      epsilon;
}

dimensions      [0 2 -3 0 0 0 0];
internalField   uniform 9e-06;

boundaryField
{
    inlet       { type inletOutlet; inletValue uniform 9e-06; value uniform 9e-06; }
    outlet      { type inletOutlet; inletValue uniform 9e-06; value uniform 9e-06; }
    atmosphere  { type inletOutlet; inletValue uniform 9e-06; value uniform 9e-06; }
    bottom      { type zeroGradient; }      // slip bottom
    box         { type epsilonWallFunction; value uniform 9e-06; }
    wall1       { type empty; }
    wall2       { type empty; }
}
