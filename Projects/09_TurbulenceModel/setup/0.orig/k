FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 1e-05;

boundaryField
{
    inlet       { type inletOutlet; inletValue uniform 1e-05; value uniform 1e-05; }
    outlet      { type inletOutlet; inletValue uniform 1e-05; value uniform 1e-05; }
    atmosphere  { type inletOutlet; inletValue uniform 1e-05; value uniform 1e-05; }
    bottom      { type zeroGradient; }      // slip bottom
    box         { type kqRWallFunction; value uniform 1e-05; }
    wall1       { type empty; }
    wall2       { type empty; }
}
