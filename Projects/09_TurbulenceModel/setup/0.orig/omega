FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform 10;

boundaryField
{
    inlet       { type inletOutlet; inletValue uniform 10; value uniform 10; }
    outlet      { type inletOutlet; inletValue uniform 10; value uniform 10; }
    atmosphere  { type inletOutlet; inletValue uniform 10; value uniform 10; }
    bottom      { type zeroGradient; }      // slip bottom
    box         { type omegaWallFunction; value uniform 10; }
    wall1       { type empty; }
    wall2       { type empty; }
}
