FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// waves2Foam: no relaxation zones, waves from ESI waveModels BCs
seaLevel        0;

relaxationNames ();

inlet
{
    alpha           alpha.water;

    waveModel       StokesII;

    nPaddle         1;

    waveHeight      0.08;    // wave height [m]

    waveAngle       0.0;

    rampTime        3.0;

    activeAbsorption yes;

    wavePeriod      1.993;     // wave period [s]
}

outlet
{
    alpha           alpha.water;

    waveModel       shallowWaterAbsorption;

    nPaddle         1;
}

