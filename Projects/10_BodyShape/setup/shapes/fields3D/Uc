FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Uc;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        type fixedValue;
        value uniform (0 0 0);
    }
    outlet
    {
        type fixedValue;
        value uniform (0 0 0);
    }
    bottom
    {
        type fixedValue;
        value uniform (0 0 0);
    }
    atmosphere
    {
        type zeroGradient;
    }
    box
    {
        type swenseBodyVelocity;
        exactWallFlux true;
        value uniform (0 0 0);
    }
    wall1
    {
        type slip;
    }
    wall2
    {
        type slip;
    }
}
