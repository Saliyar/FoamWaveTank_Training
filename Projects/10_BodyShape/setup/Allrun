#!/bin/sh
#------------------------------------------------------------------------------
# Project 10 - Influence of body shape
#   Based on the Day 3 moored box, solved with waveIsoFoam (FoamWaveTank):
#   sixDoFRigidBodyMotion + MoorDyn v2 (moorDynR2 restraint).
#
#   ./Allclean; ./Allrun
#   NP=8 ./Allrun       number of cores (default 4; NP=1 is serial)
#   SHAPE=box ./Allrun     cylinder (default) | box | box3D | sphere (3D: use NP=16 or more)
#
# Solver: waveIsoFoam built by ./Allwmake of FoamWaveTank. Another build:
#   SOLVER=/path/to/waveIsoFoam ./Allrun
#------------------------------------------------------------------------------
cd "${0%/*}" || exit 1
. ${WM_PROJECT_DIR:?Source OpenFOAM-v2506/etc/bashrc first}/bin/tools/RunFunctions

if ls log.* >/dev/null 2>&1; then
    echo "This case has results: run ./Allclean first, or copy the setup to a new folder"
    exit 1
fi

NP=${NP:-4}
SOLVER=${SOLVER:-waveIsoFoam}
[ -x "$SOLVER" ] || command -v "$SOLVER" >/dev/null || { echo "Solver not found: $SOLVER (build FoamWaveTank first)"; exit 1; }

touch case.foam
restore0Dir
SHAPE=${SHAPE:-cylinder}
[ -d shapes/$SHAPE ] || { echo "SHAPE must be box, cylinder, box3D or sphere"; exit 1; }
cp shapes/$SHAPE/blockMeshDict system/blockMeshDict
cp shapes/$SHAPE/massProperties constant/massProperties
cp shapes/$SHAPE/lines_v2_bodyC.txt Mooring/lines_v2_bodyC.txt
case $SHAPE in
    box3D|sphere) cp shapes/fields3D/* 0/ ;;
esac

# 1. Mesh
runApplication blockMesh || exit 1
runApplication checkMesh || exit 1

# 2. Initial free surface: still water below z = 0
runApplication setFields || exit 1

# 3. Run
if [ "$NP" -gt 1 ]; then
    cat > system/decomposeParDict <<EOF
FoamFile { version 2.0; format ascii; class dictionary; object decomposeParDict; }
numberOfSubdomains $NP;
method simple;
coeffs { n ($NP 1 1); }
EOF
    runApplication decomposePar || exit 1
    runParallel "$SOLVER" || { echo "Solver failed, see log.${SOLVER##*/}"; exit 1; }
    runApplication reconstructPar -newTimes
else
    runApplication "$SOLVER" || { echo "Solver failed, see log.${SOLVER##*/}"; exit 1; }
fi

#------------------------------------------------------------------------------
