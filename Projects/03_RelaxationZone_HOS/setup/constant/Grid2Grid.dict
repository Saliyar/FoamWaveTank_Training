FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      Grid2Grid.dict;
}

// HOS-NWT result read by Grid2Grid (path relative to the case folder)
Grid2Grid       HOSNWT;

HOSNWT
{
    type                NWT;
    fileType            ASCII;
    filePath            HOS/Results/modes_HOS_SWENSE.dat;
    interpolationOrder  3;          // cubic in time and space

    // Vertical grid on which Grid2Grid rebuilds the HOS velocity
    zMeshType           meshRatio;
    zMin                -0.5;       // bottom
    zMax                 0.5;       // top of the CFD domain
    nZMin               50;
    nZMax               50;
    zMinRatio           3;
    zMaxRatio           3;
}
