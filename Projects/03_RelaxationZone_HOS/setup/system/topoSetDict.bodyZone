FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}

// SWENSE body zone for the coarse and fine meshes: cells around the box, |x| < 0.5 m,
// below z = 0.1118 m (the medium mesh uses the stored constant/cellZones.bodyZone)
actions
(
    {
        name    bodyZone;
        type    cellZoneSet;
        action  new;
        source  boxToCell;
        box     (-0.5 -1 -0.5) (0.5 1 0.1118);
    }
);
